# =========================
# Default behavior
# =========================
* text=auto

# =========================
# Force LF (Linux/macOS style)
# =========================
*.js text eol=lf
*.ts text eol=lf
*.py text eol=lf
*.java text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# =========================
# Force CRLF (Windows scripts)
# =========================
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# =========================
# Binary files (no conversion)
# =========================
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.exe binary

# =========================
# Markdown & text docs
# =========================
*.md text eol=lf
*.txt text eol=lf
